{
  "name": "brokket-feed-news",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm build:news && pnpm build:admin",
    "build:news": "tsc --noEmit",
    "build:admin": "vite build",
    "check": "pnpm build && pnpm test:deduplication",
    "test:deduplication": "tsx src/deduplication-check.ts",
    "admin:dev": "vite",
    "admin:preview": "vite preview",
    "news:run": "tsx src/github-runner.ts",
    "news:deactivate-irrelevant": "tsx src/deactivate-irrelevant.ts",
    "news:activate": "tsx src/activate-relevant.ts",
    "news:deduplicate": "tsx src/deduplicate-feed.ts",
    "news:check-regional": "tsx src/regional-check.ts",
    "report": "tsx src/report.ts",
    "state:merge": "tsx src/merge-state.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/node": "latest",
    "tsx": "^4.23.13",
    "typescript": "latest"
  }
}
