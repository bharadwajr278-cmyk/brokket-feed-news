{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brokket-real-estate-news",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "BROKKET_API_URL": "http://13.126.103.246/api/feed-news",
    "MAX_AGE_HOURS": "72"
  },
  "kv_namespaces": [
    {
      "binding": "NEWS_STATE"
    }
  ],
  "triggers": { "crons": [] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
